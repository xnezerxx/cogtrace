{
  "name": "cogtrace",
  "version": "0.1.0",
  "description": "Working-Memory Cognitive Load Simulator & Eye-Jump Visualizer for Code (TypeScript, JavaScript & Python)",
  "keywords": [
    "cognitive-complexity",
    "working-memory",
    "code-analysis",
    "static-analysis",
    "ast",
    "liveness-analysis",
    "developer-tools",
    "refactoring",
    "visualization",
    "typescript",
    "python"
  ],
  "homepage": "https://xnezerxx.github.io/cogtrace/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xnezerxx/cogtrace.git"
  },
  "bugs": {
    "url": "https://github.com/xnezerxx/cogtrace/issues"
  },
  "author": "xnezerxx",
  "license": "MIT",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "bin": {
    "cogtrace": "./dist/cli/index.js"
  },
  "files": [
    "dist/core",
    "dist/cli",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:web": "vite build",
    "build": "npm run build:cli && npm run build:web",
    "preview": "vite preview",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
